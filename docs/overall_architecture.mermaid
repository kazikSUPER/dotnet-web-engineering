graph TB
    subgraph "CLIENT LAYER"
        WEB[Web / curl / Swagger]
    end

    subgraph "EDGE"
        GW["Platform.ApiGateway<br/>YARP reverse proxy<br/>fixed port 5000<br/>CorrelationId + route logging"]
    end

    subgraph "COMPOSITION"
        AGG["Platform.Aggregator<br/>parallel downstream calls<br/>partial failures + warnings<br/>REST + gRPC clients"]
    end

    subgraph "CATALOG MICROSERVICE"
        CAT_API["Catalog.Api<br/>/api/products"]
        CAT_BLL["Catalog.Bll<br/>services, DTO, validators"]
        CAT_DAL["Catalog.Dal<br/>EF Core, repositories, UoW"]
        CAT_DB[("SQL Server<br/>CatalogDb<br/>Products / Categories<br/>ProductCategories / ProductDetails<br/>ProductImages")]
        CAT_API --> CAT_BLL --> CAT_DAL --> CAT_DB
    end

    subgraph "ORDERS MICROSERVICE"
        ORD_API["Orders.Api<br/>/api/orders /api/customers /api/payments"]
        ORD_BLL["Orders.Bll<br/>services, DTO, validators"]
        ORD_DAL["Orders.Dal<br/>EF Core, repositories, UoW"]
        ORD_DB[("SQL Server<br/>OrdersDb<br/>Customers / Orders / OrderItems<br/>Payments / OrderStatusHistory")]
        ORD_API --> ORD_BLL --> ORD_DAL --> ORD_DB
    end

    subgraph "REVIEWS MICROSERVICE"
        REV_API["Reviews.WebApi<br/>/api/reviews /api/product-ratings /api/moderation"]
        REV_APP["Reviews.Application<br/>CQRS MediatR + behaviors"]
        REV_INF["Reviews.Infrastructure<br/>MongoDB repositories, transactions"]
        REV_DB[("MongoDB<br/>BakeryReviewsDB<br/>reviews / product_ratings<br/>moderation_logs")]
        REV_API --> REV_APP --> REV_INF --> REV_DB
    end

    subgraph "SHARED"
        SD["Platform.ServiceDefaults<br/>Serilog + OpenTelemetry + health<br/>service discovery + CorrelationId"]
        REDIS[("Redis<br/>L2 cache (lab 6)")]
        HOST["Platform.AppHost<br/>.NET Aspire orchestration<br/>WithDataVolume + WaitFor"]
        DASH["Aspire Dashboard<br/>logs / traces / metrics (OTLP)"]
    end

    WEB --> GW
    GW -->|/api/orders, /api/customers, /api/payments| ORD_API
    GW -->|/api/products| CAT_API
    GW -->|/api/reviews, /api/product-ratings, /api/moderation| REV_API
    GW -->|/api/aggregator| AGG
    AGG -->|HTTP / gRPC| ORD_API
    AGG -->|HTTP / gRPC| CAT_API
    AGG -->|HTTP / gRPC| REV_API
    AGG --> REDIS
    ORD_API --> REDIS
    CAT_API --> REDIS
    REV_API --> REDIS
    SD -.-> GW
    SD -.-> AGG
    SD -.-> CAT_API
    SD -.-> ORD_API
    SD -.-> REV_API
    HOST -.->|orchestrates| GW
    HOST -.-> AGG
    HOST -.-> CAT_API
    HOST -.-> ORD_API
    HOST -.-> REV_API
    HOST -.-> CAT_DB
    HOST -.-> ORD_DB
    HOST -.-> REV_DB
    HOST -.-> REDIS
    GW -.->|OTLP| DASH
    AGG -.->|OTLP| DASH
    CAT_API -.->|OTLP| DASH
    ORD_API -.->|OTLP| DASH
    REV_API -.->|OTLP| DASH

    classDef default fill:#ffffff,stroke:#334155,stroke-width:1px,color:#0f172a;