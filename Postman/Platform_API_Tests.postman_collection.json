  "item": [
    {
      "name": "01. Authentication & Security (OIDC / JWT)",
      "item": [
        {
          "name": "IdentityServer - Request M2M Token (Client Credentials)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "aggregator",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "aggregator-secret",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "orders.read orders.write products.read products.write reviews.read reviews.write",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{identityServerUrl}}/connect/token",
              "host": [
                "{{identityServerUrl}}"
              ],
              "path": [
                "connect",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token acquired successfully (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.access_token).to.not.be.empty;",
                  "    pm.environment.set('m2mToken', json.access_token);",
                  "    pm.collectionVariables.set('m2mToken', json.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Local Auth - Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"student@bakery.com\", \"password\": \"Password123!\", \"firstName\": \"Студент\", \"lastName\": \"ЧНУ\"}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 200 or 409 (already registered)', function () {",
                  "    pm.expect([200, 201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Local Auth - Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"student@bakery.com\", \"password\": \"Password123!\"}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
