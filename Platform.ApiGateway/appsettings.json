{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator-orders": {
        "ClusterId": "aggregator",
        "Order": 100,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        }
      },
      "auth": {
        "ClusterId": "auth",
        "Order": 50,
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users": {
        "ClusterId": "auth",
        "Order": 50,
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "payments-service": {
        "ClusterId": "payments",
        "Order": 50,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "orders-by-id": {
        "ClusterId": "orders",
        "Order": 0,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "customers": {
        "ClusterId": "orders",
        "Order": 0,
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "orders",
        "Order": 0,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "products": {
        "ClusterId": "catalog",
        "Order": 0,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Order": 0,
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        }
      },
      "product-ratings": {
        "ClusterId": "reviews",
        "Order": 0,
        "Match": {
          "Path": "/api/product-ratings/{**catch-all}"
        }
      },
      "moderation": {
        "ClusterId": "reviews",
        "Order": 0,
        "Match": {
          "Path": "/api/moderation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders-api": {
            "Address": "http://orders-api"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:10",
          "ActivityTimeout": "00:00:15"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      },
      "catalog": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog-api"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:10",
          "ActivityTimeout": "00:00:15"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      },
      "reviews": {
        "Destinations": {
          "reviews-api": {
            "Address": "http://reviews-api"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:10",
          "ActivityTimeout": "00:00:15"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      },
      "aggregator": {
        "Destinations": {
          "aggregator": {
            "Address": "http://aggregator"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:20",
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      },
      "auth": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth-api"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:10",
          "ActivityTimeout": "00:00:15"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      },
      "payments": {
        "Destinations": {
          "payments-api": {
            "Address": "http://payments-api"
          }
        },
        "HttpClient": {
          "Timeout": "00:00:10",
          "ActivityTimeout": "00:00:15"
        },
        "LoadBalancingPolicy": "PowerOfTwoChoices"
      }
    }
  }
}
