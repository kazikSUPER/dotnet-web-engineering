{
  "ConnectionStrings": {
    "BakeryReviewsDB": "mongodb://localhost:27017"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "BakeryReviewsDB",
    "ReviewsCollectionName": "reviews",
    "ProductRatingsCollectionName": "product_ratings",
    "ModerationLogsCollectionName": "moderation_logs",
    "UseTransactions": true,
    "CreateIndexesOnStartup": true,
    "SeedOnStartup": true,
    "ServerSelectionTimeoutMilliseconds": 5000
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5180",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://localhost:5280",
        "Protocols": "Http2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "MongoDB": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
